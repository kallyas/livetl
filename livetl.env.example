# Copy to livetl.env to set defaults for ./livetl.sh.
# Anything you pass on the command line overrides these.

# Used when livetl.sh is run with no URL argument (e.g. from systemd).
# STREAM_URL=https://twitch.tv/somechannel

SOURCE_LANG=ja           # spoken language; leave unset for auto-detect
TARGET_LANG=en
MODEL=small              # tiny|base|small|medium|large-v3|large-v3-turbo
MT=auto                  # auto|marian|nllb|google|whisper|none

# Browser / OBS overlay. Use 0.0.0.0 to reach it from another machine --
# there is no authentication, so keep it behind a firewall or an SSH tunnel.
OVERLAY=0
OVERLAY_HOST=127.0.0.1
OVERLAY_PORT=8765

# OBS_FILE=subs.txt
# LOG_FILE=captions.jsonl

# Passed through verbatim. Quotes are required -- the value contains spaces.
# EXTRA_ARGS="--soft-max 4 --timing"
# EXTRA_ARGS="--asr faster --asr-device cuda --model large-v3-turbo"

# GOOGLE_TRANSLATE_API_KEY=...
